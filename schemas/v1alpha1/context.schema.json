{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abox.dev/schemas/context/v1alpha1",
  "title": "Agent Box Context v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "box", "workspace", "repositories", "workspaceService", "services", "routes", "ports", "commands", "policy", "durability"],
  "properties": {
    "schemaVersion": {"const": "abox.context/v1alpha1"},
    "box": {"$ref": "#/$defs/box"},
    "workspace": {"$ref": "#/$defs/workspace"},
    "repositories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repository"}},
    "workspaceService": {"$ref": "#/$defs/workspaceService"},
    "services": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/service"}},
    "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}},
    "ports": {"type": "array", "items": {"$ref": "#/$defs/port"}},
    "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}},
    "policy": {"$ref": "#/$defs/policy"},
    "durability": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "absolutePath": {"type": "string", "pattern": "^/", "minLength": 2},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "box": {
      "type": "object", "additionalProperties": false, "required": ["id", "taskKey", "state", "generation", "planDigest"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "taskKey": {"type": "string", "minLength": 1},
        "state": {"const": "READY"}, "generation": {"type": "integer", "minimum": 1}, "planDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "workspace": {
      "type": "object", "additionalProperties": false, "required": ["id", "manifestPath", "root"],
      "properties": {"id": {"type": "string", "minLength": 1}, "manifestPath": {"$ref": "#/$defs/absolutePath"}, "root": {"$ref": "#/$defs/absolutePath"}}
    },
    "repository": {
      "type": "object", "additionalProperties": false, "required": ["name", "branch", "baseCommit", "path"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "branch": {"type": "string", "minLength": 1},
        "baseCommit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}, "path": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "workspaceService": {
      "type": "object", "additionalProperties": false, "required": ["name", "workingDirectory"],
      "properties": {"name": {"type": "string", "minLength": 1}, "workingDirectory": {"type": "string", "minLength": 1}}
    },
    "service": {
      "type": "object", "additionalProperties": false, "required": ["name", "ready"],
      "properties": {"name": {"type": "string", "minLength": 1}, "ready": {"type": "boolean"}}
    },
    "route": {
      "type": "object", "additionalProperties": false, "required": ["name", "url", "ready"],
      "properties": {"name": {"type": "string", "minLength": 1}, "url": {"type": "string", "pattern": "^http://"}, "ready": {"type": "boolean"}}
    },
    "port": {
      "type": "object", "additionalProperties": false, "required": ["name", "host", "port", "ready"],
      "properties": {"name": {"type": "string", "minLength": 1}, "host": {"const": "127.0.0.1"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "ready": {"type": "boolean"}}
    },
    "command": {
      "type": "object", "additionalProperties": false, "required": ["name", "argv"],
      "properties": {"name": {"type": "string", "minLength": 1}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    },
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["gitMetadata", "dockerSocket", "machineMounts", "networkEgress"],
      "properties": {
        "gitMetadata": {"enum": ["read-only", "read-write"]}, "dockerSocket": {"const": "deny"},
        "machineMounts": {"const": "declared-only"}, "networkEgress": {"enum": ["allow", "deny"]}
      }
    }
  }
}
