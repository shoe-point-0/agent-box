{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abox.dev/schemas/plan/v1alpha1",
  "title": "Agent Box Plan v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaceId", "boxId", "taskKey", "manifest", "repositories", "runtimeHost", "compose", "workspaceService", "mounts", "policy", "tools", "planDigest"],
  "properties": {
    "schemaVersion": {"const": "abox.plan/v1alpha1"},
    "workspaceId": {"type": "string", "minLength": 1},
    "boxId": {"type": "string", "minLength": 1},
    "taskKey": {"type": "string", "minLength": 1},
    "manifest": {"$ref": "#/$defs/artifact"},
    "repositories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repository"}},
    "runtimeHost": {"$ref": "#/$defs/runtimeHost"},
    "compose": {"$ref": "#/$defs/compose"},
    "workspaceService": {"$ref": "#/$defs/workspaceService"},
    "mounts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mount"}},
    "policy": {"$ref": "#/$defs/policy"},
    "tools": {"$ref": "#/$defs/tools"},
    "planDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "absolutePath": {"type": "string", "pattern": "^/", "minLength": 2},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "digest"],
      "properties": {"path": {"$ref": "#/$defs/absolutePath"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sourcePath", "baseCommit", "branch", "worktreePath", "gitCommonDir"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sourcePath": {"$ref": "#/$defs/absolutePath"},
        "baseCommit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "branch": {"type": "string", "minLength": 1},
        "worktreePath": {"$ref": "#/$defs/absolutePath"},
        "gitCommonDir": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "runtimeHost": {
      "type": "object", "additionalProperties": false,
      "required": ["driver", "instanceName", "cpuMillicores", "memoryBytes", "diskBytes"],
      "properties": {
        "driver": {"type": "string", "enum": ["lima-vz", "lima-qemu"]},
        "instanceName": {"type": "string", "minLength": 1},
        "cpuMillicores": {"type": "integer", "minimum": 1},
        "memoryBytes": {"type": "integer", "minimum": 1},
        "diskBytes": {"type": "integer", "minimum": 1}
      }
    },
    "compose": {
      "type": "object", "additionalProperties": false, "required": ["projectName", "includes", "profiles"],
      "properties": {
        "projectName": {"type": "string", "minLength": 1},
        "includes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
        "profiles": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "workspaceService": {
      "type": "object", "additionalProperties": false, "required": ["name", "repository", "workingDirectory"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "workingDirectory": {"type": "string", "minLength": 1}
      }
    },
    "mount": {
      "type": "object", "additionalProperties": false, "required": ["path", "services", "writable"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "services": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "writable": {"type": "boolean"}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["gitMetadata", "dockerSocket", "machineMounts", "networkEgress"],
      "properties": {
        "gitMetadata": {"type": "string", "enum": ["read-only", "read-write"]},
        "dockerSocket": {"const": "deny"},
        "machineMounts": {"const": "declared-only"},
        "networkEgress": {"type": "string", "enum": ["allow", "deny"]}
      }
    },
    "tools": {
      "type": "object", "additionalProperties": false, "required": ["agentBox", "git", "lima", "docker", "compose"],
      "properties": {
        "agentBox": {"type": "string", "minLength": 1},
        "git": {"type": "string", "minLength": 1},
        "lima": {"type": "string", "minLength": 1},
        "docker": {"type": "string", "minLength": 1},
        "compose": {"type": "string", "minLength": 1}
      }
    }
  }
}
